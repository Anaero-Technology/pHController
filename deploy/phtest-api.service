[Unit]
Description=pH Controller API + Web UI
# Only meaningful once the network is up. Comitup also starts/stops this unit
# via its `web_service:` setting (see comitup.conf), so it runs when the Pi is
# joined to Wi-Fi and is stopped while in hotspot/config mode.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Let the non-root 'pi' user bind privileged port 80, so the UI is reachable at
# http://pHController.local with no :port suffix (mDNS via Comitup appliance
# mode). No nginx / iptables redirect needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/pi/pHTest
# Block until the Pi actually has internet, so the app serves only when online.
ExecStartPre=/home/pi/pHTest/deploy/wait-online.sh
ExecStart=/home/pi/pHTest/.venv/bin/uvicorn api.app:app --host 0.0.0.0 --port 80
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
